@using System.Text.Json.Serialization
@using MOSTComputers.Models.Product.Models
@using MOSTComputers.UI.Web.Blazor.Components.Primitives

<li id="@ItemData.EditorId" name="propertyItem"
    class="properties-list-item"
    data-is-link="@IsLink"
    data-product-characteristic-id="@ItemData.ProductCharacteristic.Id">
    <table class="property-table">
        <tbody>
            <tr class="property-data-row">

                <td class="property-td-alignedOnTop property-is-active-td">
                    <input name="propertyValueActiveCheckbox"
                        type="checkbox" value="@ItemData.IsActive" tabindex="-1" />
                </td>

                <td class="property-td-alignedOnTop property-characteristic-td">
                    <p>@ItemData.ProductCharacteristic.Name</p>
                </td>

                <td class="property-value-td property-td-alignedOnTop">
                    <div class="property-value-textarea-container">
                        <textarea name="propertyValueInput"
                            class="property-value-textarea"
                            value="@ItemData.Value"
                            spellcheck="false"
                            aria-label="Value"
                            rows="1"
                            maxlength="4000">
                        </textarea>
                    </div>
                </td>
            </tr>

            @if (ItemData.ValidationMessages.Count > 0)
            {
                <tr>
                    <td colspan="1">
                    </td>
                    <td colspan="4">
                        <ValidationMessages Messages="ItemData.ValidationMessages" />
                    </td>
                </tr>
            }
        </tbody>
    </table>
</li>

@code{

    public sealed class ProductPropertyDisplayData
    {
        public required string EditorId { get; set; }
        public required ProductCharacteristic ProductCharacteristic { get; set; }
        public string? Value { get; set; }

        public bool IsActive { get; set; } = true;
        public List<string> ValidationMessages { get; set; } = new();
    }

    public sealed class ProductPropertyRecoveryJsonData
    {
        [JsonPropertyName("editorId")] public required string EditorId { get; set; }
        [JsonPropertyName("productCharacteristicId")] public required int ProductCharacteristicId { get; set; }
        [JsonPropertyName("value")] public string? Value { get; set; }

        [JsonPropertyName("isActive")] public bool IsActive { get; set; } = true;
    }

    [Parameter, EditorRequired] public required ProductPropertyDisplayData ItemData { get; set; }

    private bool IsLink => ItemData.ProductCharacteristic?.KWPrCh == ProductCharacteristicType.Link;
}
