@using MOSTComputers.UI.Web.Blazor.Components.Primitives

<Popup IsVisible="IsVisible"
    PopupMarginOptions='new() { Left = "30vw", Top = "35vh", Right = "30vw", Bottom = "35vh" }'
    DisplayHeader="false"
    ClosedBy="none">
    <ChildContent>
        <div class="data-changed-popup-body">
            <p class="unsaved-changes-text">There are unsaved changes:</p>

            <div class="option-buttons-container">
                <div class="option-button-container">
                    <button name="unsavedChangesPopupSaveButton" type="button"
                        class="btn btn-primary">
                        Save
                    </button>
                </div>

                <div class="option-button-container last">
                    <button name="unsavedChangesPopupExitButton" type="button"
                        class="btn btn-danger">
                        Exit
                    </button>
                </div>
            </div>
        </div>
    </ChildContent>
</Popup>

@code{
    [Parameter] public bool IsVisible { get; set; } = true;
}
