@using System.Text.Json.Serialization
@using MOSTComputers.UI.Web.Blazor.Components.Primitives
@using MOSTComputers.UI.Web.Blazor.Endpoints.Images
@using static MOSTComputers.UI.Web.Blazor.Components.ProductEditor.SingleProductEditorPopup.SingleProductEditorPopup

@{
    string imageDataUrl = $"{ProductImageDataEndpoints.EndpointGroupRoute}/{ItemData.Id}";
}

<li id="@ItemData.EditorId"
    name="productImageItem"
    class="image-list-item"
    draggable="true"
    data-image-type="@ItemType"
    data-image-id="@ItemData.Id">

    <button name="productImageButton" aria-label="Image #@(ItemData.Index)" class="btn image-button"
        data-image-url="@imageDataUrl"
        style="background-image: url('@imageDataUrl');">
    </button>

    @if (ItemData.RelatedImageFile != null)
    {
        <div class="image-active-checkbox-container">
            <input id="imageActiveCheckbox-@ItemData.Index" name="imageFileActiveCheckbox"
                checked="@ItemData.RelatedImageFile.Active" type="checkbox"
                class="image-active-checkbox"
                aria-label="Toggle image active" />
        </div>
    }

    <div class="image-delete-button-container">
        <button name="productImageDeleteButton" type="button" class="btn-close image-delete-button"
            aria-label="Delete"/>
    </div>

    <div>
        @if (ItemData.DateModified != null)
        {
            <p class="image-date-text">
                @ItemData.DateModified.Value.ToString("MM.dd.yyyy")
            </p>
        }
        else
        {
            <p class="image-date-text">
                No date provided
            </p>
        }
    </div>

    <p class="file-empty-placeholder"></p>

    @if (ItemData.RelatedImageFile?.FileName != null)
    {
        string imageFileUrl = $"/api/images/imageFileData/{ItemData.RelatedImageFile.FileName}";

        string? imageDisplayOrderString = null;

        if (ItemData.RelatedImageFile.DisplayOrder != null)
        {
            imageDisplayOrderString = $"{ItemData.RelatedImageFile.DisplayOrder}: ";
        }

        <div class="image-file-name-container">
            <a href="@imageFileUrl" target="_blank" rel="noopener noreferrer" class="image-file-name">
                <span name="imageFileDisplayOrderText">@imageDisplayOrderString</span>
                @ItemData.RelatedImageFile.FileName
            </a>
        </div>
    }
    else
    {
        <p class="file-empty-placeholder"></p>
    }

    <ValidationMessages Messages="ItemData.ValidationMessages" />
</li>

@code{
    public sealed class ProductImageListItemData : ProductImageListItemBase
    {
        public required int Index { get; set; }
        public required int Id { get; set; }
        public DateTime? DateModified { get; set; }
        public ProductImageItemFileDisplayData? RelatedImageFile { get; set; }
        public List<string> ValidationMessages { get; set; } = new();
    }

    public sealed class ProductImageItemFileDisplayData
    {
        public required int Id { get; set; }
        public required string FileName { get; set; }
        public int? DisplayOrder { get; set; }
        public bool Active { get; set; }
    }

    public sealed class ProductImageItemRecoveryJsonData : ProductImageRecoveryJsonDataBase
    {
        public sealed override string ItemType => ProductImageListItem.ItemType;

        [JsonPropertyName("id")] public required int Id { get; set; }
        [JsonPropertyName("relatedImageFile")] public ProductImageItemFileRecoveryJsonData? RelatedImageFile { get; set; }
    }

    public sealed class ProductImageItemFileRecoveryJsonData
    {
        [JsonPropertyName("active")] public required bool Active { get; set; }
    }

    internal const string ItemType = "image";

    [Parameter, EditorRequired] public required ProductImageListItemData ItemData { get; set; }
}
