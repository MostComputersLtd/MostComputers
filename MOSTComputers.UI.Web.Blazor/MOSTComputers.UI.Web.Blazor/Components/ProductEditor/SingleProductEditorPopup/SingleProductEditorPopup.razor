@using System.Text.Json.Serialization
@using MOSTComputers.Models.Product.Models
@using MOSTComputers.Models.Product.Models.ProductStatuses
@using MOSTComputers.Services.SearchStringOrigin.Models
@using MOSTComputers.UI.Web.Blazor.Components.Primitives
@using MOSTComputers.UI.Web.Blazor.Components.Product.Promotion
@using MOSTComputers.UI.Web.Blazor.Components.Product.SearchString
@using static MOSTComputers.UI.Web.Blazor.Utils.DataToTextConversion

<Popup PopupId="singleProductEditorPopup"
    IsVisible="IsVisible"
    PopupMarginOptions="PopupMarginOptions">
    <HeaderContent>
        <div class="single-product-editor-popup-header">

            <input id="singleEditorProductIdHiddenInput" type="hidden" class="hidden" value="@Product.Id"/>

            <h5 class="modal-title">Status:</h5>

            <select id="singleEditorProductNewStatusSelect"
                class="header-item product-new-status-select"
                aria-label="Select Product New Status">

                @foreach (ProductNewStatus productNewStatus in ProductNewStatusesInSelect)
                {
                    <option value="@((int)productNewStatus)" selected="@(productNewStatus == ProductStatuses?.ProductNewStatus)">
                        @GetStringFromProductNewStatus(productNewStatus)
                    </option>
                }

                @if (ProductStatuses == null)
                {
                    <option value="" selected disabled>-</option>
                }
            </select>

            <h4 class="popup-header-text header-product-id-text">CSTID: @Product.Id</h4>
            <h4 class="popup-header-text">@Product.Name</h4>

            <button id="singleEditorShowProductDataPopupButton"
                class="btn btn-outline-success header-item">
                Info 1
            </button>

            <button id="singleEditorShowProductLegacyDisplayPopupButton"
                class="btn btn-outline-success header-item">
                Info 2
            </button>

            <a href="/product/productData/@Product.Id" target="_blank" class="btn btn-outline-success header-item">
                Info 3
            </a>

            <a href="api/product/xml/id=@Product.Id" target="_blank" rel="noopener noreferrer" class="btn btn-outline-success header-item">
                XML
            </a>

            <button id="singleEditorShowPromotionProductFileEditorPopupButton"
                class="btn btn-outline-success header-item">
                Promo
            </button>

            <button id="singleEditorShowSearchStringPopupButton"
                class="btn btn-outline-success header-item">
                SStr
            </button>

            <div class="single-product-editor-popup-header-buttons-container header-item">

                <button id="singleEditorAddImageFileButton" class="btn btn-outline-success">
                    Add Image
                </button>

                <input id="singleEditorAddImageFileInput" type="file" accept="image/*"
                    class="image-file-hidden-input" tabindex="-1" />

                <button id="singleEditorAddDocumentFileButton" class="btn btn-outline-success header-item">
                    Add Document
                </button>

                <input id="singleEditorAddDocumentFileInput" type="file" accept="application/pdf"
                    class="image-file-hidden-input" tabindex="-1" />

                <div>
                    <button id="singleProductEditorSaveButton"
                        class="btn btn-primary save-button button-with-loader header-item">
                        <p>Save</p>

                        <div class="round-loader-default save-button-loader"></div>
                    </button>
                </div>
            </div>
        </div>
    </HeaderContent>

    <ChildContent>
        <div class="single-product-editor-popup-body">

            <div class="main-product-info-container">
                <p class="main-product-info-text">Category: @Product.Category?.Description</p>
                <p class="main-product-info-text">Manufacturer: @Product.Manufacturer?.RealCompanyName</p>
                <p class="main-product-info-text">EAN: @Product.PartNumber1</p>
                <p class="main-product-info-text">PartNo: @Product.PartNumber2</p>
            </div>

            <div class="images-list-container">

                <ul id="singleEditorProductImageList" class="images-list">

                    @for (int i = 0; i < ProductImages.Count; i++)
                    {
                        ProductImageListItemBase imageItem = ProductImages[i];

                        switch (imageItem)
                        {
                            case PromotionFileImageListItem.PromotionFileImageItemDisplayData promotionFileData:
                            {
                                <PromotionFileImageListItem ItemData="promotionFileData" />

                                break;
                            }

                            case ProductImageListItem.ProductImageListItemData imageData:
                            {
                                <ProductImageListItem ItemData="imageData" />
                                break;
                            }

                            case ProductImageFileListItem.ProductImageFileItemData imageFileData:
                            {
                                <ProductImageFileListItem ItemData="imageFileData" />
                                break;
                            }

                            default:
                            {
                                throw new NotSupportedException();
                            }
                        }
                    }

                    <li class="image-add-button-list-item">
                        <button id="singleEditorAddImageFromClipboardFileButton" class="btn image-add-button">
                            +
                        </button>
                    </li>
                </ul>
            </div>

            <div class="promotion-data-container">

                @{
                    int? promotionPictureId = Product.AlertPictureId;

                    if (promotionPictureId == null || promotionPictureId <= 0)
                    {
                        promotionPictureId = Product.PromotionPictureId;
                    }
                }

                @if (promotionPictureId > 0)
                {
                    <div class="info-promotion-container">
                        <p>IID: @(promotionPictureId.ToString())</p>
                        <p class="info-promotion-expire-date">
                            Expire Date: @(Product.PromotionExpireDate?.ToString("dd/MMM/yyyy") ?? "-")
                        </p>
                    </div>
                }

                @if (PidPromotion != null)
                {
                    <div class="promotion-on-one-line-container">
                        <PromotionOnOneLine Promotion="PidPromotion" />
                    </div>
                }

                @if (RidPromotion != null)
                {
                    <div class="promotion-on-one-line-container">
                        <PromotionOnOneLine Promotion="RidPromotion" />
                    </div>
                }
            </div>

            <div class="search-string-table-container">
                <p>Search string: @Product.SearchString</p>

                @if (SearchStringParts != null
                    && SearchStringParts.Count > 0)
                {
                    <ProductSearchStringOriginTable SearchStringOriginDataList="SearchStringParts" />
                }
            </div>

            <div class="properties-list-container">
                <ul id="singleEditorProductPropertyList" class="properties-list">

                    @for (int i = 0; i < ProductProperties.Count; i++)
                    {
                        <ProductPropertyListItem ItemData="ProductProperties[i]" />
                    }
                </ul>
            </div>

            @if (ProductLinks.Count > 0)
            {
                <div class="properties-list-divider d-flex">
                    <p>Links:</p>

                    <hr class="properties-list-divider-line" />
                </div>
            }

            <div class="full-parent-width pb-4 d-flex flex-column">

                <div class="properties-list-container">
                    <ul id="singleEditorProductLinkList" class="properties-list">

                        @for (int i = 0; i < ProductLinks.Count; i++)
                        {
                            <ProductPropertyListItem ItemData="ProductLinks[i]" />
                        }
                    </ul>
                </div>
            </div>

            <div class="full-parent-width pb-4">
                <ul id="singleEditorProductDocumentList" class="product-documents-list">

                    @for (int i = 0; i < ProductDocuments.Count; i++)
                    {
                        <ProductDocumentListItem ItemData="ProductDocuments[i]" ProductId="Product.Id" />
                    }
                </ul>
            </div>
        </div>
    </ChildContent>
</Popup>

<div>
    <div id="singleEditorProductDataPopupContainer">
    </div>

    <div id="singleEditorProductLegacyDisplayPopupContainer">
    </div>

    <div id="singleEditorPromotionProductFileEditorPopupContainer">
    </div>

    <div id="singleEditorSearchStringPopupContainer">
    </div>

    <div id="singleEditorProductDocumentPopupContainer">
    </div>

    <div id="singleEditorUnsavedChangesPopupContainer">
    </div>
</div>

<script id="singleEditorData" type="application/json">
    @((MarkupString)JsonData)
</script>

@code {

    public class ProductImageListItemBase
    {
        public required string EditorId { get; set; }
    }

    [JsonPolymorphic]
    [JsonDerivedType(typeof(PromotionFileImageListItem.PromotionFileImageItemRecoveryJsonData), PromotionFileImageListItem.ItemType)]
    [JsonDerivedType(typeof(ProductImageListItem.ProductImageItemRecoveryJsonData), ProductImageListItem.ItemType)]
    [JsonDerivedType(typeof(ProductImageFileListItem.ProductImageFileItemRecoveryJsonData), ProductImageFileListItem.ItemType)]
    public abstract class ProductImageRecoveryJsonDataBase
    {
        public abstract string ItemType { get; }

        [JsonPropertyName("editorId")] public required string EditorId { get; set; }
    }

    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public Popup.MarginOptions PopupMarginOptions { get; set; } = new();

    [Parameter] public required Product Product { get; set; }

    [Parameter] public ProductWorkStatuses? ProductStatuses { get; set; }

    [Parameter] public List<ProductPropertyListItem.ProductPropertyDisplayData> ProductProperties { get; set; } = [];
    [Parameter] public List<ProductPropertyListItem.ProductPropertyDisplayData> ProductLinks { get; set; } = [];

    [Parameter] public List<ProductImageListItemBase> ProductImages { get; set; } = new();

    [Parameter] public List<SearchStringPartOriginData> SearchStringParts { get; set; } = new();

    [Parameter] public List<ProductDocumentListItem.ProductDocumentDisplayData> ProductDocuments { get; set; } = new();

    [Parameter] public MOSTComputers.Models.Product.Models.Promotions.Promotion? PidPromotion { get; set; }
    [Parameter] public MOSTComputers.Models.Product.Models.Promotions.Promotion? RidPromotion { get; set; }

    [Parameter, EditorRequired] public required string JsonData { get; set; }

    private static IReadOnlyList<ProductNewStatus> DefaultProductNewStatusesInSelect = [
        ProductNewStatus.ReadyForUse,
        ProductNewStatus.Postponed1,
        ProductNewStatus.Postponed2
    ];

    private List<ProductNewStatus> ProductNewStatusesInSelect = new(DefaultProductNewStatusesInSelect);

    [Parameter] public EventCallback OnSaveSuccessful { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (ProductStatuses != null && !ProductNewStatusesInSelect.Contains(ProductStatuses.ProductNewStatus))
        {
            ProductNewStatusesInSelect.Add(ProductStatuses.ProductNewStatus);
        }
    }
}
