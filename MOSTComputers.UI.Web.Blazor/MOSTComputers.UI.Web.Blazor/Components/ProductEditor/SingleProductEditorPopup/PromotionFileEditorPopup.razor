@using System.Text.Json.Serialization
@using MOSTComputers.Models.Product.Models
@using MOSTComputers.Models.Product.Models.Promotions
@using MOSTComputers.Models.Product.Models.Promotions.Files
@using MOSTComputers.UI.Web.Blazor.Components.Primitives
@using MOSTComputers.UI.Web.Blazor.Components.Product.Promotion
@using OneOf

<Popup IsVisible="IsVisible" PopupMarginOptions="PopupMarginOptions">
    <HeaderContent>

        <div class="promotion-product-file-editor-header">

            <div class="header-text-container">
                <h5 class="popup-header-text">Promotions:</h5>

                <h4 class="popup-header-text">CSTID: @Product.Id</h4>

                @if (Product.Manufacturer is not null)
                {
                    <h4 class="popup-header-text">Mfr: @Product.Manufacturer.RealCompanyName</h4>
                }
                @if (Product.Category is not null)
                {
                    <h4 class="popup-header-text">@Product.Category.Description</h4>
                }

                <h4 class="popup-header-text">@Product.Name</h4>
            </div>

            @if (!_isReadonly)
            {
                <div id="promotionProductFileEditorAddButton" class="add-button-container">
                    <button class="btn btn-primary add-button">
                        +
                    </button>
                </div>
            }
        </div>
    </HeaderContent>

    <ChildContent>
        <div class="promotion-product-file-editor-body">
            @{
                int? promotionPictureId = Product.AlertPictureId;

                if (promotionPictureId is null || promotionPictureId <= 0)
                {
                    promotionPictureId = Product.PromotionPictureId;
                }
            }

            @if (promotionPictureId > 0)
            {
                <div class="info-promotion-container">
                    <p>IID: @(Product.AlertPictureId.ToString() ?? "-")</p>

                    <p class="info-promotion-expire-date">Expire Date: @(Product.AlertExpireDate?.ToString("dd/MMM/yyyy") ?? "-")</p>
                </div>
            }

            @if (PidPromotion is not null)
            {
                <PromotionOnOneLine Promotion="PidPromotion" />
            }

            @if (RidPromotion is not null)
            {
                <PromotionOnOneLine Promotion="RidPromotion" />
            }

            <div class="promotion-product-files-table-container">

                <table id="promotionProductFileEditorTable" class="promotion-product-files-table">

                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Active</th>
                            <th>File Id</th>
                            <th>Img All Id</th>
                            <th>Valid From</th>
                            <th>Valid To</th>
                            <th></th>
                            <th></th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (PromotionProductFiles.IsT0)
                        {
                            List<PromotionProductFileInfoReadonlyDisplayData> readonlyFiles = PromotionProductFiles.AsT0;

                            for (int i = 0; i < readonlyFiles.Count; i++)
                            {
                                PromotionProductFileInfoReadonlyDisplayData promotionProductFileInfo = readonlyFiles[i];

                                <PromotionFileEditorPopupItem ReadonlyItemData="promotionProductFileInfo"/>
                            }
                        }
                        else
                        {
                            List<PromotionProductFileInfoDisplayData> files = PromotionProductFiles.AsT1;

                            for (int i = 0; i < files.Count; i++)
                            {
                                PromotionProductFileInfoDisplayData promotionProductFileInfo = files[i];

                                <PromotionFileEditorPopupItem ItemData="promotionProductFileInfo"/>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </ChildContent>
</Popup>

<div id="singlePromotionProductEditorPopupContainer">
</div>

@code {
    public sealed class PromotionProductFileInfoReadonlyDisplayData
    {
        public int? Id { get; set; }
        public DateTime? ValidFrom { get; set; }
        public DateTime? ValidTo { get; set; }
        public bool Active { get; set; } = false;
        public int? ProductImageId { get; set; }
        public PromotionFileInfo? PromotionFileInfo { get; set; }
    }

    public sealed class PromotionProductFileInfoDisplayData
    {
        public required string EditorId { get; set; }
        public int? Id { get; set; }
        public DateTime? ValidFrom { get; set; }
        public DateTime? ValidTo { get; set; }
        public bool Active { get; set; } = false;
        public int? ProductImageId { get; set; }
        public PromotionFileInfo? PromotionFileInfo { get; set; }
    } 

    public sealed class PromotionProductFileEditorJsonData
    {
        [JsonPropertyName("editorId")] public required string EditorId { get; set; }
        [JsonPropertyName("id")] public int? Id { get; set; }
        [JsonPropertyName("promotionFileId")] public int? PromotionFileId { get; set; }
        [JsonPropertyName("validFrom")] public DateTime? ValidFrom { get; set; }
        [JsonPropertyName("validTo")] public DateTime? ValidTo { get; set; }
        [JsonPropertyName("active")] public bool Active { get; set; } = false;
    }

    public sealed class PromotionProductFileRecoveryJsonData
    {
        [JsonPropertyName("editorId")] public required string EditorId { get; set; }
        [JsonPropertyName("id")] public int? Id { get; set; }
        [JsonPropertyName("fileInfoId")] public int? PromotionFileId { get; set; }
        [JsonPropertyName("validFrom")] public DateTime? ValidFrom { get; set; }
        [JsonPropertyName("validTo")] public DateTime? ValidTo { get; set; }
        [JsonPropertyName("active")] public required bool Active { get; set; }
    }

    [Parameter] public Popup.MarginOptions PopupMarginOptions { get; set; } = new();

    [Parameter] public bool IsVisible { get; set; }

    [Parameter, EditorRequired] public required Product Product { get; set; }

    [Parameter] public Promotion? PidPromotion { get; set; }
    [Parameter] public Promotion? RidPromotion { get; set; }

    [Parameter] public OneOf<
        List<PromotionProductFileInfoReadonlyDisplayData>,
        List<PromotionProductFileInfoDisplayData>> PromotionProductFiles { get; set; }

    private bool _isReadonly => PromotionProductFiles.IsT0;
}
