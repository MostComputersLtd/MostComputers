@using MOSTComputers.UI.Web.Blazor.Components.Product.Promotion.Files
@using static MOSTComputers.UI.Web.Blazor.Utils.DataToTextConversion;

@{
    string validFromValueAsString = string.Empty;
    string validToValueAsString = string.Empty;

    if (ItemData.ValidFrom is not null)
    {
        validFromValueAsString = GetDateTimeAsStringForDateInput(ItemData.ValidFrom);
    }

    if (ItemData.ValidTo is not null)
    {
        validToValueAsString = GetDateTimeAsStringForDateInput(ItemData.ValidTo);
    }
}

<tr id="@ItemData.EditorId" name="promotionProductFileEditorItem">
    <td>@ItemData.Id</td>
    <td>
        <input id="@ItemData.EditorId-activeInput" type="checkbox"
            tabindex="-1" class="promotion-product-file-active-input" checked="@ItemData.Active" />
    </td>
    <td>@ItemData.PromotionFileInfo?.Id</td>
    <td>@(ItemData.ProductImageId?.ToString() ?? "-")</td>
    <td>
        <input id="@ItemData.EditorId-validFromInput" type="date"
            value="@validFromValueAsString" readonly />
    </td>
    <td>
        <input id="@ItemData.EditorId-validToInput" type="date"
            value="@validToValueAsString" readonly />
    </td>
    <td class="promotion-product-file-file-column">

        @if (ItemData.PromotionFileInfo is not null)
        {
            <PromotionFile FileOptions="@PromotionFile.FilePathOptions.CreateForExistingFile(
                ItemData.PromotionFileInfo.FileName)"
                class="full-parent-width full-parent-height" />
        }
        else
        {
            <p>No File</p>
        }
    </td>
    <td>
        <button name="promotionProductFileEditorEditButton" class="btn btn-light promotion-product-file-edit-button">
            <img src="/img/General/EditIcon.jpg" alt="Edit" class="promotion-product-file-edit-button-image" />
        </button>
    </td>

    @if (ShouldDisplayDeleteButton)
    {
        <td>
            <button id="promotionProductFileEditorDeleteButton" type="button" class="btn btn-danger">
                del
            </button>
        </td>
    }
</tr>

@code{
    [Parameter, EditorRequired] public required PromotionFileEditorPopup.PromotionProductFileInfoDisplayData ItemData { get; set; }
    [Parameter, EditorRequired] public required bool ShouldDisplayDeleteButton { get; set; }
}
