@using MOSTComputers.UI.Web.Blazor.Components.Product.Promotion.Files
@using OneOf
@using static MOSTComputers.UI.Web.Blazor.Utils.DataToTextConversion;

@{
    DateTime? validFrom = _isReadonly ? ItemData.AsT0.ValidFrom : ItemData.AsT1.ValidFrom;
    DateTime? validTo = _isReadonly ? ItemData.AsT0.ValidTo : ItemData.AsT1.ValidTo;

    string validFromValueAsString = string.Empty;
    string validToValueAsString = string.Empty;

    if (validFrom != null)
    {
        validFromValueAsString = GetDateTimeAsStringForDateInput(validFrom);
    }

    if (validTo != null)
    {
        validToValueAsString = GetDateTimeAsStringForDateInput(validTo);
    }
}

@if (_isReadonly)
{
    PromotionFileEditorPopup.PromotionProductFileInfoReadonlyDisplayData readonlyItemData = ItemData.AsT0;

    <tr name="promotionProductFileEditorItem">
        <td>@readonlyItemData!.Id</td>
        <td>
            <input id="@readonlyItemData.Id-activeInput" type="checkbox"
                tabindex="-1" class="promotion-product-file-active-input" checked="@readonlyItemData.Active" />
        </td>
        <td>@readonlyItemData.PromotionFileInfo?.Id</td>
        <td>@(readonlyItemData.ProductImageId?.ToString() ?? "-")</td>
        <td>
            <input id="@readonlyItemData.Id-validFromInput" type="date"
                value="@validFromValueAsString" readonly />
        </td>
        <td>
            <input id="@readonlyItemData.Id-validToInput" type="date"
                value="@validToValueAsString" readonly />
        </td>
        <td class="promotion-product-file-file-column">

            @if (readonlyItemData.PromotionFileInfo != null)
            {
                <PromotionFile FileOptions="@PromotionFile.FilePathOptions.CreateForExistingFile(
                    readonlyItemData.PromotionFileInfo.FileName, readonlyItemData.PromotionFileInfo.ContentType)"
                    class="full-parent-width full-parent-height" />
            }
            else
            {
                <p>No File</p>
            }
        </td>
        <td>
            <button name="promotionProductFileEditorEditButton"
                class="btn btn-light promotion-product-file-edit-button"
                data-promotion-product-file-id="@readonlyItemData.Id">
                <img src="/img/General/EditIcon.jpg" alt="Edit" class="promotion-product-file-edit-button-image" />
            </button>
        </td>
    </tr>
}
else
{
    PromotionFileEditorPopup.PromotionProductFileInfoDisplayData itemData = ItemData.AsT1;

    <tr id="@itemData.EditorId" name="promotionProductFileEditorItem">
        <td>@itemData.Id</td>
        <td>
            <input id="@itemData.EditorId-activeInput" type="checkbox"
                tabindex="-1" class="promotion-product-file-active-input" checked="@itemData.Active" />
        </td>
        <td>@itemData.PromotionFileInfo?.Id</td>
        <td>@(itemData.ProductImageId?.ToString() ?? "-")</td>
        <td>
            <input id="@itemData.EditorId-validFromInput" type="date"
                value="@validFromValueAsString" readonly />
        </td>
        <td>
            <input id="@itemData.EditorId-validToInput" type="date"
                value="@validToValueAsString" readonly />
        </td>
        <td class="promotion-product-file-file-column">

            @if (itemData.PromotionFileInfo != null)
            {
                <PromotionFile FileOptions="@PromotionFile.FilePathOptions.CreateForExistingFile(
                    itemData.PromotionFileInfo.FileName, itemData.PromotionFileInfo.ContentType)"
                    class="full-parent-width full-parent-height" />
            }
            else
            {
                <p>No File</p>
            }
        </td>
        <td>
            <button name="promotionProductFileEditorEditButton" class="btn btn-light promotion-product-file-edit-button">
                <img src="/img/General/EditIcon.jpg" alt="Edit" class="promotion-product-file-edit-button-image" />
            </button>
        </td>

        <td>
            <button name="promotionProductFileEditorDeleteButton" type="button" class="btn btn-danger">
                del
            </button>
        </td>
    </tr>
}

@code{
    [Parameter] public OneOf<
        PromotionFileEditorPopup.PromotionProductFileInfoReadonlyDisplayData,
        PromotionFileEditorPopup.PromotionProductFileInfoDisplayData> ItemData { get; set; }

    private bool _isReadonly => ItemData.IsT0;
}
