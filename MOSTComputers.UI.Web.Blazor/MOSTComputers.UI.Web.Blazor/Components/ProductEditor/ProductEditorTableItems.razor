@using static MOSTComputers.UI.Web.Blazor.Components.Pages.ProductEditor2

@for (int i = 0; i < ProductDatas.Count; i++)
{
    ProductEditorProductData productData = ProductDatas[i];

    <ProductEditorTableItem ItemData="productData"/>
}

<script id="productEditorItemsData" type="application/json">
    @((MarkupString)JsonData)
</script>

@code{

    [Parameter, EditorRequired] public required List<ProductEditorProductData> ProductDatas { get; set; }
    [Parameter, EditorRequired] public required string JsonData { get; set; }
}
