@using MOSTComputers.Models.Product.Models

<table id="addRelatedProductSearchResultsTable"
	class="related-product-search-results-table">

	@foreach (Product product in Products)
	{
		<tr id="relatedProductSearchResult-@product.Id"
			name="relatedProductSearchResult"
			class="related-product-search-result"
			onclick="addRelatedProductToPromotion(@product.Id, 'relatedProductSearchResult-@product.Id')"
			data-related-product-search-result-product-id="@product.Id">

			<td class="related-product-search-result-entry-with-margin">
				<p>@product.Id</p>
			</td>

			<td class="related-product-search-result-entry-with-margin">
				<p>@product.Name</p>
			</td>

			<td>
				<p>@product.SearchString</p>
			</td>
		</tr>
	}
</table>

@code {
	[Parameter, EditorRequired] public List<Product> Products { get; set; } = new();
}