@using MOSTComputers.Models.Product.Models.Promotions.Groups

<table class="promotions-list">
    
    @foreach (PromotionDisplayData promotionData in Promotions)
    {
        GroupPromotionContent promotion = promotionData.Promotion;
        PromotionGroup promotionGroup = promotionData.PromotionGroup;

        string startDateString = promotion.StartDate is not null ? promotion.StartDate.Value.ToString("d") : "Unspecified";
        string expirationDateString = "Unspecified";

        string expiredText = "Active";

        if (promotion.ExpirationDate is not null)
        {
            expirationDateString = promotion.ExpirationDate.Value.ToString("d");

            if (promotion.ExpirationDate < DateTime.Now)
            {
                expiredText = "Expired";
            }
        }

        string displayOrder = promotion.DisplayOrder?.ToString() ?? "-";
        string defaultGroupPriority = promotion.DefaultGroupPriority?.ToString() ?? "-";

        <tr name="promotionListItem" class="promotion-row" data-promotion-id="@promotion.Id">
            @* onclick="openPromotionEditorForPromotion(@promotion.Id)" *@

            <td class="promotion-item-group-column">
                <p>@promotionGroup.Name (@promotionGroup.DisplayOrder)</p>
            </td>

            <td>
                <div class="promotion-data">
                    <div class="promotion-item-row">

                        <div class="promotion-item-name-container">
                            <p class="promotion-item-name">@promotion.Name</p>
                            <p>(@displayOrder, @defaultGroupPriority)</p>
                        </div>

                        @if (promotion.Disabled == true)
                        {
                            <p>Disabled</p>
                        }
                        else
                        {
                            <p>Enabled</p>
                        }

                        @if (promotion.Restricted == true)
                        {
                            <p>Restricted</p>
                        }
                    </div>


                    <div class="promotion-item-row right">
                        <p>@startDateString - @expirationDateString: @expiredText</p>
                    </div>
                </div>
            </td>
            
        </tr>
    }
</table>

@code {
    public sealed class PromotionDisplayData
    {
        public required GroupPromotionContent Promotion { get; init; }
        public required PromotionGroup PromotionGroup { get; init; }
    }

    [Parameter, EditorRequired] public required List<PromotionDisplayData> Promotions { get; set; } = new();
}
