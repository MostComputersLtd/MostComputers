@page "/productEditor2"

@attribute [ExcludeFromInteractiveRouting]
@attribute [Authorize(Roles = "ProductEditor")]

@using MOSTComputers.Models.Product.Models
@using MOSTComputers.Models.Product.Models.ProductStatuses
@using MOSTComputers.Models.Product.Models.Promotions
@using MOSTComputers.Services.ProductRegister.Models.Requests.Product
@using MOSTComputers.Services.ProductRegister.Services.Contracts
@using Microsoft.AspNetCore.Authorization
@using static MOSTComputers.UI.Web.Blazor.Utils.DataToTextConversion

@inject ICategoryService CategoryService
@inject IManufacturerService ManufacturerService

<PageTitle>Product Editor</PageTitle>

<HeadContent>
    <link href="@Assets["css/ScopeHtmlAndBodyHeightToViewport.css"]" rel="stylesheet" />

    @* <script src="@Assets[_carouselScriptUrl]"></script>
    <script src="@Assets[_productDataScriptUrl]"></script> *@

    <script src="@Assets[_popupScriptUrl]"></script>

    <script type="module" src="@Assets[_pageScriptUrl]"></script>
</HeadContent>

<div id="productEditorPage" class="product-editor-page product-data-table-scrollable-container">

    <header class="product-editor-page-header">
        <ul class="header-list">

            <li class="header-list-item">
                <select id="productNewStatusSelect">

                    <option value="">All</option>

                    @foreach (ProductEditorProductNewStatusSearchOptions productNewStatus in _productNewStatusesInSelect)
                    {
                        <option value="@((int)productNewStatus)">
                            @GetStringFromProductEditorNewStatusSearchOptions(productNewStatus)
                        </option>
                    }
                </select>
            </li>

            <li class="header-list-item header-user-input-list-item">
                <input id="userInput" type="text" class="user-input" placeholder="Search..." />
            </li>

            <li class="header-list-item header-search-button-list-item">
                <button id="productEditorSearchButton" type="button"
                    class="btn btn-outline-primary search-button button-with-loader">
                    <p>Search</p>
                    <div class="round-loader-default"></div>
                </button>

            </li>

            <li class="header-list-item">
                <select id="categorySelect"> 

                    <option value="" selected>All</option>

                    @foreach (Category category in _categoriesInSelect)
                    {
                        <option value="@category.Id">@category.Description</option>
                    }
                </select>
            </li>

            <li class="header-list-item">
                <select id="manufacturerSelect" class="manufacturer-select">

                    <option value="-1" selected data-default-option>All</option>

                    @foreach (Manufacturer manufacturer in _manufacturersInSelect)
                    {
                        <option value="@manufacturer.Id">@manufacturer.RealCompanyName</option>
                    }
                </select>
            </li>

            <li class="header-list-item">
                <select id="productStatusSelect">

                    <option value="">All</option>

                    @foreach (ProductStatusSearchOptions productStatus in _productStatusesInSelect)
                    {
                        <option value="@((int)productStatus)"
                            selected="@(productStatus == _defaultProductStatus)">
                            @GetStringFromProductStatusSearchOptions(productStatus)
                        </option>
                    }
                </select>
            </li>

            <li class="header-list-item">
                <select id="promotionStatusSelect">

                    <option value="" selected>All</option>

                    @foreach (PromotionSearchOptions promotionSearchOptions in _promotionSearchOptionsInSelect)
                    {
                        <option value="@((int)promotionSearchOptions)">
                            @GetStringFromPromotionSearchOptions(promotionSearchOptions)
                        </option>
                    }
                </select>
            </li>

            <li class="header-list-item">
                <select id="resultsCountSelect">

                    @foreach (int resultCount in _resultCountsInSelect)
                    {
                        <option value="@resultCount" selected="@(resultCount == _defaultResultCount)">
                            @resultCount
                        </option>
                    }

                    <option value="@_maxProductSearchResultCount">
                        All
                    </option>
                </select>
            </li>
        </ul>
    </header>

    <div class="product-data-table-scrollable-container">
        <table id="productEditorItemsTable" class="product-data-table table-with-small-horizontal-padding-on-cells">
            <thead class="product-data-table-head">
                <tr>
                    <th id="productEditorItemsTablePlShowColumnHeader"
                        class="product-data-table-column-with-sort-options">
                        PLSH <span id="productEditorItemsTablePlShowColumnHeaderOrderText">
                            @_defaultColumnOrderSuffix
                        </span>
                    </th>

                    <th id="productEditorItemsTableProductWorkStatusColumnHeader"
                        class="product-data-table-column-with-sort-options">
                        Work Stat <span id="productEditorItemsTableProductWorkStatusColumnHeaderOrderText">
                            @_defaultColumnOrderSuffix
                        </span>
                    </th>

                    <th id="productEditorItemsTableHasImagesColumnHeader"
                        class="product-data-table-column-with-sort-options">
                        P <span id="productEditorItemsTableHasImagesColumnHeaderOrderText">
                            @_defaultColumnOrderSuffix
                        </span>
                    </th>

                    <th>Stat</th>
                    <th>CSTID</th>
                    <th>Name</th>
                    <th>SStr</th>
                    <th>PID</th>
                    <th>RID</th>
                    <th>IID</th>
                    <th>Promo</th>
                    <th>N XML</th>
                    @* <th>O XML</th>
                    <th>O Img XML</th> *@
                    <th>Upload</th>
                    <th>Img</th>
                    <th>RImg</th>
                    @* <th>
                        <button id="productEditorChangeSelectedPropertiesAndImagesButton" type="button" class="btn btn-outline-primary"
                            @onclick='() => OnChangeAllButtonPressed(
                            "productEditorChangeSelectedPropertiesAndImagesButton",
                            "productEditorChangeSelectedPropertiesAndImagesLoader")'>
                            S Old All
                        </button>

                        <div id="productEditorChangeSelectedPropertiesAndImagesLoader" class="round-loader-default" style="display: none;"></div>
                    </th>
                    <th></th> *@
                </tr>
            </thead>

            <tbody>
            </tbody>
        </table>
    </div>
</div>


<div id="singleProductEditorPopupContainer">
</div>

<div id="productXmlPopupContainer">
</div>

<div id="productSearchStringPopupContainer">
</div>

<div id="productPropertiesPopupContainer">
</div>

<div id="productImageFilesPopupContainer">
</div>

<div id="productImagesPopupContainer">
</div>

<div id="productPromotionPopupContainer">
</div>

<div id="productInfoPromotionPopupContainer">
</div>

<div id="promotionProductFilePopupContainer">
</div>

@code {
    public sealed class ProductEditorProductData
    {
        public required Product Product { get; set; }

        public ProductWorkStatuses? ProductStatuses { get; set; }

        public required int ProductPropertiesCount { get; set; }
        public required int ImageFilesCount { get; set; }
        public required int OriginalImagesCount { get; set; }
        public required bool OriginalFirstImageExists { get; set; }
        public List<Promotion>? ProductPromotions { get; set; }
        public int? SearchStringPartsCount { get; set; }
        public int? PromotionFilesCount { get; set; }
    }

    public enum ProductEditorProductNewStatusSearchOptions
    {
        New = 0,
        WorkInProgress = 1,
        ReadyForUse = 2,
        Postponed1 = 3,
        Postponed2 = 4,
        NewAndWorkInProgress = 5,
        LastAdded = 6,
        LastAddedNew = 7,
        None = 8,
    }

    private const string _popupScriptUrl = "js/Popup/Popup.js";
    private const string _pageScriptUrl = "js/Pages/ProductEditor/Page.js";

    private const string _carouselScriptUrl = "js/Carousel/Carousel.js";
    private const string _productDataScriptUrl = "js/Product/ProductData.js";

    private const int _maxProductSearchResultCount = 2000;

    private List<Category> _categoriesInSelect { get; set; } = new();

    private List<Manufacturer> _manufacturersInSelect { get; set; } = new();

    private ProductStatusSearchOptions _defaultProductStatus { get; set; } = ProductStatusSearchOptions.AvailableAndCall;

    private List<ProductStatusSearchOptions> _productStatusesInSelect { get; set; } = [
        ProductStatusSearchOptions.AvailableAndCall,
        ProductStatusSearchOptions.Available,
        ProductStatusSearchOptions.Call,
    ];

    private List<ProductEditorProductNewStatusSearchOptions> _productNewStatusesInSelect { get; set; } = [
        ProductEditorProductNewStatusSearchOptions.New,
        ProductEditorProductNewStatusSearchOptions.WorkInProgress,
        ProductEditorProductNewStatusSearchOptions.NewAndWorkInProgress,
        ProductEditorProductNewStatusSearchOptions.ReadyForUse,
        ProductEditorProductNewStatusSearchOptions.Postponed1,
        ProductEditorProductNewStatusSearchOptions.Postponed2,
        ProductEditorProductNewStatusSearchOptions.LastAdded,
        ProductEditorProductNewStatusSearchOptions.LastAddedNew,
        ProductEditorProductNewStatusSearchOptions.None,
    ];


    private List<PromotionSearchOptions> _promotionSearchOptionsInSelect { get; set; } = [
        PromotionSearchOptions.None,
        PromotionSearchOptions.P,
        PromotionSearchOptions.R,
        PromotionSearchOptions.I,
        PromotionSearchOptions.Discount
    ];

    private int _defaultResultCount { get; set; } = 50;

    private List<int> _resultCountsInSelect { get; set; } = [
        50,
        100,
        200,
        300,
    ];

    protected override async Task OnInitializedAsync()
    {
        _categoriesInSelect = await CategoryService.GetAllAsync();
        _manufacturersInSelect = await ManufacturerService.GetAllAsync();
    }

    private const string _defaultColumnOrderSuffix = "•";

    private static string? GetStringFromProductEditorNewStatusSearchOptions(ProductEditorProductNewStatusSearchOptions productStatusEnum)
    {
        return productStatusEnum switch
        {
            ProductEditorProductNewStatusSearchOptions.New => "New",
            ProductEditorProductNewStatusSearchOptions.WorkInProgress => "Work",
            ProductEditorProductNewStatusSearchOptions.NewAndWorkInProgress => "New & Work",
            ProductEditorProductNewStatusSearchOptions.ReadyForUse => "Ready",
            ProductEditorProductNewStatusSearchOptions.Postponed1 => "Post1",
            ProductEditorProductNewStatusSearchOptions.Postponed2 => "Post2",
            ProductEditorProductNewStatusSearchOptions.LastAdded => "Last Added",
            ProductEditorProductNewStatusSearchOptions.LastAddedNew => "Last Added & New",
            ProductEditorProductNewStatusSearchOptions.None => "None",
            _ => null
        };
    }

    public static ProductEditorProductData TEMP__Map(Pages.ProductEditor.ProductEditorProductData data)
    {
        return new()
        {
            Product = data.Product,
            ProductStatuses = data.ProductStatuses,
            ProductPropertiesCount = data.ProductPropertiesCount,
            ImageFilesCount = data.DirectoryImagesCount,
            OriginalImagesCount = data.OriginalImagesCount,
            OriginalFirstImageExists = data.OriginalFirstImageExists,
            ProductPromotions = data.ProductPromotions,
            SearchStringPartsCount = data.SearchStringParts?.Count ?? 0,
            PromotionFilesCount = data.PromotionFilesCount,
        };
    }
}
