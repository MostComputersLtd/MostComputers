    [JSInvokable("SearchProductsFromJs")]
    public async Task SearchProductsFromJsAsync()
    {
        await SearchProductsAsync();

        StateHasChanged();
    }

    private async Task SearchProductsAsync()
    {
        if (_jsModule is not null)
        {
            await _jsModule.InvokeVoidAsync("alternateElementsDisplay", "productEditorSearchButton", "productEditorSearchLoader");
        }

        try
        {
            int? selectedCategoryId = int.TryParse(SelectedCategoryId, out int categoryId) ? categoryId : null;
            int? selectedManufacturerId = int.TryParse(SelectedManufacturerId, out int manufacturerId) ? manufacturerId : null;

            if (selectedManufacturerId == -1)
            {
                selectedManufacturerId = null;
            }

            ProductStatusSearchOptions? selectedProductStatus = ProductStatusSearchOptions.TryParse(
                SelectedProductStatus, out ProductStatusSearchOptions productStatus)
                    ? productStatus
                    : null;

            bool parsedSelectedProductNewStatus = Enum.TryParse<ProductEditorProductNewStatusSearchOptions>(
                SelectedProductNewStatus, out ProductEditorProductNewStatusSearchOptions productEditorNewStatus);

            ProductEditorProductNewStatusSearchOptions? selectedProductEditorNewStatus = parsedSelectedProductNewStatus
                ? productEditorNewStatus
                : null;

            PromotionSearchOptions? selectedPromotionSearchOptions = PromotionSearchOptions.TryParse(
                SelectedPromotionSearchOptions, out PromotionSearchOptions promotionSearchOptions)
                    ? promotionSearchOptions
                    : null;

            int selectedResultCount = int.TryParse(
                SelectedResultCount, out int resultCount)
                    ? resultCount
                    : ResultCountsInSelect.Min();

            selectedResultCount = Math.Min(selectedResultCount, _allResultCount);

            bool orderProductsByLastAddedDate = selectedProductEditorNewStatus == ProductEditorProductNewStatusSearchOptions.LastAdded
                || selectedProductEditorNewStatus == ProductEditorProductNewStatusSearchOptions.LastAddedNew;

            bool orderProductsFromSecondCategoryUp = selectedCategoryId == null && string.IsNullOrWhiteSpace(UserInputString);

            List<Product> products = await GetProductsFromSearchOptionsAsync(
                UserInputString,
                selectedCategoryId,
                selectedManufacturerId,
                selectedProductStatus,
                selectedProductEditorNewStatus,
                selectedPromotionSearchOptions,
                selectedResultCount,
                orderProductsByLastAddedDate,
                orderProductsFromSecondCategoryUp);

             List<ProductEditor.ProductEditorProductData> oldProductDatas = await ProductEditorDataService.GetProductEditorProductDatasAsync(products);

             List<ProductEditorProductData> productDatas = new();

             foreach (ProductEditor.ProductEditorProductData productData in oldProductDatas)
             {
                productDatas.Add(TEMP__Map(productData));
             }

            ProductDatas.Clear();

            ProductDatas.AddRange(productDatas);

        }
        finally
        {
            if (_jsModule is not null)
            {
                await _jsModule.InvokeVoidAsync("alternateElementsDisplay", "productEditorSearchButton", "productEditorSearchLoader");
            }
        }
    }

    private async Task<List<Product>> GetProductsFromSearchOptionsAsync(
        string? userInputString = null,
        int? categoryId = null,
        int? manufacturerId = null,
        ProductStatusSearchOptions? productStatusSearchOptions = null,
        ProductEditorProductNewStatusSearchOptions? productEditorNewStatusSearchOptions = null,
        PromotionSearchOptions? promotionSearchOptions = null,
        int? maxResultCount = null,
        bool orderProductsByLastAddedDate = false,
        bool orderProductsFromSecondCategoryUp = false)
    {
        List<ProductNewStatusSearchOptions>? productNewStatusSearchOptions
            = GetSearchOptionsFromEditorSearchOptions(productEditorNewStatusSearchOptions);

        int? searchMaxResultCount = maxResultCount;

        if (orderProductsByLastAddedDate || orderProductsFromSecondCategoryUp)
        {
            searchMaxResultCount = null;
        }

        ProductSearchRequest productSearchRequest = new()
        {
            OnlyVisibleByEndUsers = false,
            UserInputString = userInputString,
            CategoryId = categoryId,
            ManufacturerId = manufacturerId,
            ProductNewStatuses = productNewStatusSearchOptions,
            ProductStatus = productStatusSearchOptions,
            PromotionSearchOptions =  promotionSearchOptions,
            MaxResultCount = searchMaxResultCount,
        };

        List<Product> products = await ProductSearchService.SearchProductsAsync(productSearchRequest);

        _productOrderByStatusDate = orderProductsByLastAddedDate ? ProductOrderByStatusDate.LastUpdatedDate : ProductOrderByStatusDate.None;
        _productOrderByImages = ProductOrderByImages.None;
        _productOrderByPlShow = ProductOrderByPlShow.None;
        _productOrderByCategory = orderProductsFromSecondCategoryUp ? ProductOrderByCategory.FromSecondUp : ProductOrderByCategory.None;

        if (orderProductsByLastAddedDate)
        {
            int? finalResultCount = LastAddedProductsSearchCount;

            products = OrderProductsByLastUpdatedStatusDate(products);

            if (searchMaxResultCount is not null)
            {
                finalResultCount = Math.Min(searchMaxResultCount.Value, LastAddedProductsSearchCount);
            }

            if (maxResultCount is null) return products;

            return products.Slice(0, Math.Min(maxResultCount.Value, products.Count));
        }
        else if (!orderProductsByLastAddedDate && orderProductsFromSecondCategoryUp)
        {
            SortProductsFromSecondCategoryUp(products);

            if (maxResultCount is null) return products;

            return products.Slice(0, Math.Min(maxResultCount.Value, products.Count));
        }

        if (maxResultCount is not null && maxResultCount > 0)
        {
            return products
                .OrderBy(x => x.DisplayOrder ?? int.MaxValue)
                .ThenBy(x => x.Id)
                .Take(maxResultCount.Value)
                .ToList();
        }

        return products
            .OrderBy(x => x.DisplayOrder ?? int.MaxValue)
            .ThenBy(x => x.Id)
            .ToList();
    }

    private static void SortProductEditorDatasByLastUpdatedStatusDate(List<ProductEditorProductData> products)
    {
        products.Sort((productData1, productData2) => CompareProductEditorDatasByLastUpdatedStatusDate(productData1, productData2));
    }

    private List<Product> OrderProductsByLastUpdatedStatusDate(List<Product> products)
    {
        return products.OrderByDescending(x => x.Id).ToList();
    }

    private static int CompareProductEditorDatasByLastUpdatedStatusDate(
        ProductEditorProductData productData1,
        ProductEditorProductData productData2)
    {
        DateTime lastUpdatedStatusDate1 = productData1.ProductStatuses?.LastUpdateDate ?? DateTime.MinValue;
        DateTime lastUpdatedStatusDate2 = productData2.ProductStatuses?.LastUpdateDate ?? DateTime.MinValue;

        return lastUpdatedStatusDate2.CompareTo(lastUpdatedStatusDate1);
    }

    private static void SortProductEditorDatasFromSecondCategoryUp(List<ProductEditorProductData> products)
    {
        products.Sort((productData1, productData2) => CompareProductsFromSecondCategoryUp(productData1.Product, productData2.Product));
    }

    private static void SortProductsFromSecondCategoryUp(List<Product> products)
    {
        products.Sort(CompareProductsFromSecondCategoryUp);
    }

    private static List<ProductEditorProductData> ThenOrderByProductEditorDatasFromSecondCategoryUp(IOrderedEnumerable<ProductEditorProductData> products)
    {
        return products
            .ThenBy(x => (x.Product.CategoryId > 1) ? x.Product.CategoryId.Value : int.MaxValue)
            .ThenBy(x => x.Product.DisplayOrder ?? int.MaxValue)
            .ThenBy(x => x.Product.Id)
            .ToList();
    }

    private static int CompareProductsFromSecondCategoryUp(Product product1, Product product2)
    {
        int categorySortIndex1 = (product1.CategoryId > 1) ? product1.CategoryId.Value : int.MaxValue;
        int categorySortIndex2 = (product2.CategoryId > 1) ? product2.CategoryId.Value : int.MaxValue;

        int categoryComparison = categorySortIndex1 - categorySortIndex2;

        if (categoryComparison != 0) return categoryComparison;

        int displayOrder1 = product1.DisplayOrder ?? int.MaxValue;
        int displayOrder2 = product2.DisplayOrder ?? int.MaxValue;

        int displayOrderComparison = displayOrder1 - displayOrder2;

        if (displayOrderComparison != 0) return displayOrderComparison;

        return product1.Id.CompareTo(product2.Id);
    }

    private static List<ProductNewStatusSearchOptions>? GetSearchOptionsFromEditorSearchOptions(
        ProductEditorProductNewStatusSearchOptions? productEditorProductNewStatusSearchOptions)
    {
        return productEditorProductNewStatusSearchOptions switch
        {
            ProductEditorProductNewStatusSearchOptions.New => [ProductNewStatusSearchOptions.New],
            ProductEditorProductNewStatusSearchOptions.WorkInProgress => [ProductNewStatusSearchOptions.WorkInProgress],
            ProductEditorProductNewStatusSearchOptions.NewAndWorkInProgress => [ProductNewStatusSearchOptions.New, ProductNewStatusSearchOptions.WorkInProgress],
            ProductEditorProductNewStatusSearchOptions.ReadyForUse => [ProductNewStatusSearchOptions.ReadyForUse],
            ProductEditorProductNewStatusSearchOptions.Postponed1 => [ProductNewStatusSearchOptions.Postponed1],
            ProductEditorProductNewStatusSearchOptions.Postponed2 => [ProductNewStatusSearchOptions.Postponed2],
            ProductEditorProductNewStatusSearchOptions.LastAddedNew => [ProductNewStatusSearchOptions.New],
            ProductEditorProductNewStatusSearchOptions.None => [ProductNewStatusSearchOptions.None],
            _ => null
        };
    }

    private async Task OnSingleProductEditorSaveAsync()
    {
        if (_productSingleEditorPopupData is null) return;

        Product product = _productSingleEditorPopupData.ProductData.Product;

        int productToDisplayIndexInList = ProductDatas.FindIndex(x => x.Product.Id == product.Id);

        if (productToDisplayIndexInList < 0) return;

        ProductEditorProductData productEditorProductData = TEMP__Map(await ProductEditorDataService.GetProductEditorProductDataAsync(product));

        _productSingleEditorPopupData = new()
        {
            ProductData = productEditorProductData
        };

        ProductDatas[productToDisplayIndexInList] = productEditorProductData;
    }

