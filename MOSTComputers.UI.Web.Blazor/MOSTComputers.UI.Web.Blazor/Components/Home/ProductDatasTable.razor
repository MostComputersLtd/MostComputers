@using static MOSTComputers.UI.Web.Blazor.Components.Pages.Home

<table class="products-data-table table-with-small-horizontal-padding-on-cells">
    <thead class="products-data-table-head">
        <tr>
            <th>Promo</th>
            <th>Stat</th>
            <th>Qty</th>
            <th>CSTID</th>
            <th>Name</th>
            <th>Price</th>
            <th>Mfr</th>
            <th>EAN</th>
            <th>Part No. 2</th>
            <th>SStr</th>
        </tr>
    </thead>

    <tbody>

        <ProductDatasTableItems
            ProductDisplayDatas="ProductDisplayDatas"
            ShowImages="ShowImages"
            UnavailableProducts="UnavailableProducts"/>
    </tbody>
</table>

@code {

    [Parameter, EditorRequired] public required List<ProductDisplayData> ProductDisplayDatas { get; set; }
    [Parameter] public List<MOSTComputers.Models.Product.Models.Product>? UnavailableProducts { get; set; } = null;
    [Parameter] public bool ShowImages { get; set; } = false;
}
