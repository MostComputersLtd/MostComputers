@using MOSTComputers.Services.DataAccess.Documents.Models

@using static MOSTComputers.UI.Web.Blazor.Utils.DataToTextConversion;

@{
    string? orderDateTimeStartingValue = GetDateTimeAsStringForDateInput(Order.OrderDate ?? _defaultOrderDate);
    string? readDateTimeStartingValue = Order.ReadTime != null ? GetDateTimeAsStringForDateInput(Order.ReadTime) : "-";
}

@code{
    private static readonly DateTime _defaultOrderDate = DateTime.Today;

    [Parameter, EditorRequired] public required Order Order { get; set; }
}
