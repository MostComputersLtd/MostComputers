@using MOSTComputers.Services.DataAccess.Documents.Models

@using static MOSTComputers.UI.Web.Blazor.Utils.DataToTextConversion;

@{
    string? orderDateTimeStartingValue = GetDateTimeAsStringForDateInput(Order.OrderDate ?? _defaultOrderDate);
    string? readDateTimeStartingValue = Order.ReadTime != null ? GetDateTimeAsStringForDateInput(Order.ReadTime) : "-";
}

<div class="order-edit-row multiple-fields">
	<div class="order-edit-row-item">
        <label for="orderStatus" class="order-edit-input-label">Status</label>
        <input type="text" id="orderStatus" class="order-edit-input" value="@Order.Status" />
    </div>
    <div class="order-edit-row-item">
        <p class="order-edit-input-label">ID: @Order.Id</p>
    </div>
    <div class="order-edit-row-item">
        <label for="orderStartDate" class="order-edit-input-label">Quote ID</label>
        <input type="text" id="orderStartDate" class="order-edit-input" value="@Order.QuoteId" />
    </div>
</div>

<div class="order-edit-row multiple-fields">
	<div class="order-edit-row-item">
        <label for="orderStartDate" class="order-edit-input-label">Order Date</label>
        <input type="date" id="orderStartDate" class="order-edit-input order-edit-date-input"
            value="@orderDateTimeStartingValue" />
    </div>
    <div class="order-edit-row-item">
        <label for="orderExpirationDate" class="order-edit-input-label">Read Date</label>
        <input type="date" id="orderExpirationDate" class="order-edit-input order-edit-date-input"
            value="@readDateTimeStartingValue" />
    </div>
</div>

<div class="order-edit-row multiple-fields">
    <div class="order-edit-row-item">
        <label for="orderDisplayOrder" class="order-edit-input-label">Display Order</label>
        <input type="number" id="orderDisplayOrder" class="order-edit-input" value="@Order.BusinessId" />
    </div>

    <div class="order-edit-row-item">
        <label for="orderGroupEditorSelect" class="order-edit-input-label">Group</label>	

        <select id="orderGroupEditorSelect" class="order-group-editor-select">

            @if (Order.GroupId == null)
            {
                <option value="" selected disabled>Select a group</option>
            }
            else
            {
                <option value="" disabled>Select a group</option>
            }

            @foreach (orderGroup orderGroup in AvailableorderGroups)
            {
                @if (Order.GroupId == orderGroup.Id)
                {
                    <option value="@orderGroup.Id" selected>@orderGroup.Name</option>
                }
                else
                {
                    <option value="@orderGroup.Id">@orderGroup.Name</option>
                }
            }
        </select>
    </div>
</div>

<div class="order-edit-row multiple-fields">
    <div class="order-edit-row-item center-content">
        <label for="orderDisabled" class="order-edit-input-label">Disabled</label>

        @if (Order.Disabled == true)
        {
            <input type="checkbox" id="orderDisabled" class="order-edit-checkbox" checked />
        }
        else
        {
            <input type="checkbox" id="orderDisabled" class="order-edit-checkbox" />
        }
    </div>

    <div class="order-edit-row-item center-content">
        <label for="orderRestricted" class="order-edit-input-label">Restricted</label>

        @if (Order.Restricted == true)
        {
            <input type="checkbox" id="orderRestricted" class="order-edit-checkbox" checked />
        }
        else
        {
            <input type="checkbox" id="orderRestricted" class="order-edit-checkbox" />
        }
    </div>
</div>

<div class="order-edit-row multiple-fields">
    <div class="order-edit-row-item center-content">
        <label for="orderMemberDefault" class="order-edit-input-label">Member Of Default Group</label>

        @if (Order.MemberOfDefaultGroup == true)
        {
            <input type="checkbox" id="orderMemberDefault" class="order-edit-checkbox" checked />
        }
        else
        {
            <input type="checkbox" id="orderMemberDefault" class="order-edit-checkbox" />
        }
    </div>

    <div class="order-edit-row-item center-content">
        <label for="orderDefaultPriority" class="order-edit-input-label">Default Group Priority</label>
        <input type="number" id="orderDefaultPriority" class="order-edit-input" value="@Order.DefaultGroupPriority" />
    </div>
</div>

@code{
    private static readonly DateTime _defaultOrderDate = DateTime.Today;

    [Parameter, EditorRequired] public required Order Order { get; set; }
}
