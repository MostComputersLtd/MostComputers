@model MOSTComputers.UI.Web.Client.Pages.Shared.Components.ProductData.CarouselPartialsModel
@{
	Layout = null;
}

<button type="button"
		class="btn carousel-indicator @(Model.IsActive ? "active-carousel-indicator" : string.Empty)"
		onclick="goTo('@Model.CarouselId', @Model.ImageCarouselIndex)">

	@if (!Model.Item.IsUsingHtmlContent)
	{
		<img src="@Url.Content(Model.Item.ImageSrcOrHtmlContent)" class="carousel-indicator-image" alt="Navigate to image">
	}
	else
	{
		<div class="carousel-indicator-html-content-item">
			<div class="carousel-indicator-html-content-container">

				@Html.Raw(Model.Item.ImageSrcOrHtmlContent)
			</div>
		</div>
	}
</button>
